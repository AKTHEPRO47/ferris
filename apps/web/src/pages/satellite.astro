---
import Page from '../layouts/Page.astro';
---
<Page title="Satellite explorer" description="Compare dated NASA MODIS Terra imagery over a geographic window.">
<label>Latitude<input id="lat" type="number" value="-2.2" min="-85" max="85" step=".01"/></label><label>Longitude<input id="lon" type="number" value="113.9" min="-175" max="175" step=".01"/></label><label>Window width in degrees<input id="extent" type="number" value="3" min=".1" max="10" step=".1"/></label>
<label>First date<input id="first" type="date" value="2020-08-15"/></label><label>Second date<input id="second" type="date" value="2024-08-15"/></label><button id="load">Load observations</button>
<p id="status" role="status"></p>
<label>Swipe comparison<input id="swipe" type="range" min="0" max="100" value="50"/></label>
<div class="viewer"><img id="before" alt="First dated MODIS observation"/><img id="after" alt="Second dated MODIS observation"/></div>
<p id="caption"></p><a id="external" target="_blank" rel="noreferrer">Open in NASA Worldview</a>
<article><h2>Interpreting imagery</h2><p>True-color imagery shows visible landscape context. Cloud, smoke, illumination, sensor geometry and missing coverage can affect the comparison. The swipe view does not calculate vegetation change. Quantitative NDVI analysis requires calibrated red and near-infrared reflectance with quality masking.</p><p>Source layer · MODIS_Terra_CorrectedReflectance_TrueColor. WMS 1.1.1, EPSG:4326, 900 × 900 pixels.</p></article>
</Page>
<script>
const field=(id:string)=>(document.getElementById(id) as HTMLInputElement).value;
function load(){
 const lat=Number(field('lat')),lon=Number(field('lon')),extent=Number(field('extent'));
 const status=document.getElementById('status')!;
 if(!Number.isFinite(lat)||!Number.isFinite(lon)||extent<.1||extent>10||Math.abs(lat)>85||Math.abs(lon)>175||!field('first')||!field('second')){status.textContent='Enter valid coordinates, dates, and a window from 0.1 to 10 degrees.';return;}
 const bounds=[lon-extent/2,lat-extent/2,lon+extent/2,lat+extent/2];
 let completed=0;status.textContent='Requesting NASA imagery…';
 ['before','after'].forEach((id,i)=>{
 const image=document.getElementById(id) as HTMLImageElement;
 image.onload=()=>{completed++;if(completed===2)status.textContent='Both image responses loaded. Inspect cloud and blank-pixel coverage.';};
 image.onerror=()=>status.textContent='A NASA imagery request failed. Try another date or use Worldview.';
 image.src='https://gibs.earthdata.nasa.gov/wms/epsg4326/best/wms.cgi?'+new URLSearchParams({SERVICE:'WMS',VERSION:'1.1.1',REQUEST:'GetMap',LAYERS:'MODIS_Terra_CorrectedReflectance_TrueColor',STYLES:'',SRS:'EPSG:4326',BBOX:bounds.join(','),WIDTH:'900',HEIGHT:'900',FORMAT:'image/jpeg',TIME:field(i?'second':'first')});
 });
 document.getElementById('caption')!.textContent='First observation '+field('first')+' · Second observation '+field('second')+' · Bounds '+bounds.join(', ');
 (document.getElementById('external') as HTMLAnchorElement).href='https://worldview.earthdata.nasa.gov/?v='+bounds.join(',')+'&t='+field('second');
}
document.getElementById('load')!.onclick=load;
document.getElementById('swipe')!.oninput=()=>document.getElementById('after')!.style.clipPath='inset(0 '+(100-Number(field('swipe')))+'% 0 0)';
document.getElementById('after')!.style.clipPath='inset(0 50% 0 0)';load();
</script>
<style>.viewer{position:relative;width:min(100%,850px);aspect-ratio:1;background:#071c18}.viewer img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}</style>
