---
import Navigation from '../layouts/Navigation.astro';
---
<html lang="en"><head><meta charset="utf-8"/><title>Ferris · Mission control</title><meta name="viewport" content="width=device-width"/><meta name="description" content="Inspect NASA POWER regional climate records from 2001–2025, with trend estimates, uncertainty, method and provenance."/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><meta name="theme-color" content="#0c1420"/></head><body><Navigation/><main class="landing">
<header class="hero">
  <div class="hero-copy">
    <h1>Check a regional climate trend</h1>
    <p class="lede">Annual temperature and rainfall records from NASA POWER, with the estimate, its uncertainty, and the method beside it</p>
  </div>
  <aside class="readout" aria-label="Current investigation">
    <p class="kicker mono">Current investigation</p>
    <p class="readout-place" id="readout-place">Loading record…</p>
    <p class="readout-coords mono" id="readout-coords">—</p>
    <dl class="readout-list">
      <div><dt>Source</dt><dd id="readout-source">—</dd></div>
      <div><dt>Observations</dt><dd id="readout-n">—</dd></div>
      <div><dt>Window</dt><dd>2001–2025</dd></div>
    </dl>
  </aside>
</header>

<section class="investigation" aria-label="Investigation">
  <div class="toolbar">
    <label class="field">Investigation <select id="mission"></select></label>
    <label class="field">View <select id="mode"><option value="values">Annual observations</option><option value="anomalies">Monthly seasonal anomalies</option><option value="residuals">Regression residuals</option></select></label>
    <button id="export" class="btn-secondary" type="button">Export evidence</button>
  </div>

  <figure class="chart-panel">
    <figcaption class="panel-head">
      <h2 id="chart-title">Annual record</h2>
      <p class="panel-meta mono" id="chart-meta">Loading…</p>
    </figcaption>
    <div id="chart" role="img" aria-label="Annual climate observations with fitted trend and 95% interval"></div>
  </figure>

  <section id="results" aria-live="polite"></section>
</section>

<section class="satellite" aria-labelledby="satellite-title">
  <div class="section-head">
    <h2 id="satellite-title">Inspect satellite imagery</h2>
    <p class="mono" id="image-window">—</p>
  </div>
  <p class="lede">NASA GIBS MODIS Terra true-color imagery. Clouds and missing coverage may obscure the landscape. These browse images provide geographic context for the climate record.</p>
  <div class="frames">
    <figure class="frame">
      <img id="a" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="Earlier NASA MODIS scene" loading="lazy" decoding="async"/>
      <figcaption><span class="mono">Earlier</span><input id="first" type="date" value="2018-09-15" aria-label="Earlier scene date"/></figcaption>
    </figure>
    <figure class="frame">
      <img id="b" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="Later NASA MODIS scene" loading="lazy" decoding="async"/>
      <figcaption><span class="mono">Later</span><input id="second" type="date" value="2024-09-15" aria-label="Later scene date"/></figcaption>
    </figure>
  </div>
  <p id="status" class="note" role="status"></p>
</section>

<section class="methods" aria-labelledby="methods-title">
  <h2 id="methods-title">Methods and reproducibility</h2>
  <div class="method-grid">
    <div><h3>Precipitation</h3><p>Annual precipitation is calculated from monthly mean daily rates multiplied by calendar days.</p></div>
    <div><h3>Temperature</h3><p>Annual temperature uses calendar-day weights. Monthly anomalies subtract the 2001–2025 calendar-month means.</p></div>
    <div><h3>Uncertainty</h3><p>HAC uses three Bartlett-weighted lags, a finite-sample correction and approximate Student t inference. Trend confidence intervals are conditional on this model.</p></div>
  </div>
  <p class="source-links"><a href="https://power.larc.nasa.gov/docs/services/api/temporal/monthly/">NASA POWER documentation</a><span class="mono">/</span><a href="/example">Synthetic educational example</a></p>
  <details><summary>NASA provenance</summary><pre id="provenance"></pre></details>
</section>
</main>
<script>
import * as echarts from 'echarts';
const missions=await fetch('/missions.json').then(r=>r.json());
const get=(id:string)=>document.getElementById(id)!;
const val=(id:string)=>(get(id) as HTMLInputElement).value;
get('mission').innerHTML=missions.map((m:any,i:number)=>'<option value="'+i+'">'+m.location+' · '+m.label+'</option>').join('');
const chart=echarts.init(get('chart'),undefined,{renderer:'canvas'});
let active:any;

const accent='#9bced8';
const ink='#dfe8f1';
const inkMuted='#a3b3c5';
const inkFaint='#8799ad';
const edge='#24324a';
const edgeSoft='#1c2738';
const surface='#111b2a';
const mono="'IBM Plex Mono',ui-monospace,SFMono-Regular,monospace";
const sans="'DM Sans',system-ui,sans-serif";
const coord=(v:number,pos:string,neg:string)=>Math.abs(v).toFixed(1)+'°'+(v>=0?pos:neg);
const signed=(v:number,d=3)=>(v>=0?'+':'')+v.toFixed(d);

function images(){
 const [lon,lat]=active.coordinates;
 ['first','second'].forEach((date,i)=>{
  const params=new URLSearchParams({SERVICE:'WMS',VERSION:'1.1.1',REQUEST:'GetMap',LAYERS:'MODIS_Terra_CorrectedReflectance_TrueColor',STYLES:'',SRS:'EPSG:4326',BBOX:[lon-1.5,lat-1.5,lon+1.5,lat+1.5].join(','),WIDTH:'700',HEIGHT:'700',FORMAT:'image/jpeg',TIME:val(date)});
  const img=get(i===0?'a':'b') as HTMLImageElement;
  img.onerror=()=>{get('status').textContent='An image could not load. Try another date.'};
  img.src='https://gibs.earthdata.nasa.gov/wms/epsg4326/best/wms.cgi?'+params;
  img.alt=(i===0?'Earlier':'Later')+' MODIS Terra true-color scene of '+active.location+' on '+val(date);
 });
 get('image-window').textContent=coord(lat,'N','S')+' '+coord(lon,'E','W')+' · 3° × 3°';
 get('status').textContent='Window centered on '+coord(lat,'N','S')+' '+coord(lon,'E','W')+'. Each image covers a 3° × 3° area. Blank areas may indicate missing coverage.';
}

function render(){
 active=missions[Number(val('mission'))];const mode=val('mode');
 const displayUnit=(mode==='anomalies'?active.monthly_unit:active.unit).replace(/^C$/,'°C');
 const series:any[]=[];
 if(mode==='values'){
  series.push(
   {name:'95% interval',type:'line',data:active.lower,stack:'ci',symbol:'none',silent:true,z:1,lineStyle:{opacity:0},areaStyle:{opacity:0},tooltip:{show:false},emphasis:{disabled:true}},
   {name:'95% interval top',type:'line',data:active.upper.map((u:number,i:number)=>u-active.lower[i]),stack:'ci',symbol:'none',silent:true,z:1,lineStyle:{opacity:0},areaStyle:{color:'rgba(155,206,216,.12)'},tooltip:{show:false},emphasis:{disabled:true}},
   {name:'OLS fit',type:'line',data:active.fitted,showSymbol:false,z:2,lineStyle:{type:'dashed',width:1,color:'#6f8499'},itemStyle:{color:'#6f8499'}}
  );
 }
 const seriesName=mode==='anomalies'?'Seasonal anomaly':mode==='residuals'?'Residual':active.label;
 series.push({name:seriesName,type:'line',data:active[mode],showSymbol:false,z:3,lineStyle:{width:2,color:accent},itemStyle:{color:accent}});
 chart.setOption({
  animationDuration:300,
  animationDurationUpdate:200,
  textStyle:{fontFamily:sans},
  tooltip:{trigger:'axis',backgroundColor:surface,borderColor:edge,textStyle:{color:ink,fontFamily:sans},axisPointer:{type:'line',lineStyle:{color:'#3a4b63'}},valueFormatter:(v:any)=>typeof v==='number'?v.toFixed(2):v},
  legend:{bottom:0,left:0,itemWidth:18,itemHeight:2,icon:'roundRect',textStyle:{color:inkMuted,fontFamily:sans,fontSize:12},data:[seriesName].concat(mode==='values'?['OLS fit']:[])},
  grid:{left:12,right:16,top:16,bottom:40,containLabel:true},
  dataZoom:[{type:'inside',zoomOnMouseWheel:true,moveOnMouseMove:true}],
  xAxis:{type:'category',data:mode==='anomalies'?active.monthly_dates:active.years,axisLine:{lineStyle:{color:edge}},axisTick:{show:false},axisLabel:{color:inkFaint,fontFamily:mono,fontSize:11,hideOverlap:true},splitLine:{show:false}},
  yAxis:{type:'value',scale:true,axisLine:{show:false},axisTick:{show:false},axisLabel:{color:inkFaint,fontFamily:mono,fontSize:11},splitLine:{lineStyle:{color:edgeSoft}}},
  series
 },true);

 const perDecade=active.slope*10;
 const low=active.hac_interval[0]*10;
 const high=active.hac_interval[1]*10;
 const caveat=String(active.caveat||'').trim();
 const caveatText=caveat?caveat+(/[.!?]$/.test(caveat)?'':'.'):'';
 const stats=[['HAC p-value',active.hac_p.toPrecision(3)],['Theil–Sen / decade',signed(active.theil_sen*10)+' '+active.unit],['Residual lag-1',active.lag1.toFixed(3)],['OLS R²',active.r2.toFixed(3)]];
 get('results').innerHTML='<div class="evidence"><div class="evidence-lead"><p class="kicker mono">Trend per decade</p><p class="evidence-figure">'+signed(perDecade)+'<span>'+active.unit+'</span></p><p class="evidence-sub">95% HAC interval '+signed(low)+' to '+signed(high)+' '+active.unit+' per decade</p></div><dl class="evidence-stats">'+stats.map(([label,value])=>'<div><dt>'+label+'</dt><dd>'+value+'</dd></div>').join('')+'</dl></div><div class="interpretation"><h2>Scientific interpretation</h2><p>The '+(active.slope>0?'positive':'negative')+' estimated trend '+(active.hac_p<.05?'meets':'does not meet')+' the 0.05 threshold under approximate HAC inference. '+caveatText+'</p><p class="quality">Quality audit · '+active.n+' complete annual observations. Source metadata and original monthly values are retained. Endpoint sensitivity and spatial multiple-testing checks remain pending.</p></div><aside class="next-step"><p class="kicker mono">Suggested next step</p><p>Compare '+(active.variable==='T2M'?'rainfall seasonality and land cover':'vegetation indices and rainfall anomalies')+' over the same region and dates. This rule-based suggestion requires additional evidence before attributing a cause.</p></aside>';

 const title=mode==='values'?active.label:mode==='anomalies'?'Seasonal anomalies':'Regression residuals';
 get('chart-title').textContent=active.location+' · '+title;
 get('chart-meta').textContent=displayUnit+' · '+(mode==='values'?active.n+' annual observations':mode==='anomalies'?active.monthly_dates.length+' monthly values':active.n+' residuals');
 get('chart').setAttribute('aria-label',active.location+' '+title+', '+displayUnit+', 2001–2025');

 const [lon,lat]=active.coordinates;
 get('readout-place').textContent=active.location;
 get('readout-coords').textContent=coord(lat,'N','S')+' '+coord(lon,'E','W');
 get('readout-source').textContent=active.source;
 get('readout-n').textContent=String(active.n);
 get('provenance').textContent=JSON.stringify(active.header,null,2);
 images();
}
get('mission').onchange=render;get('mode').onchange=render;get('first').onchange=images;get('second').onchange=images;
get('export').onclick=()=>{const u=URL.createObjectURL(new Blob([JSON.stringify(active,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=u;a.download='ferris-nasa-investigation.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)};
new ResizeObserver(()=>chart.resize()).observe(get('chart'));render();
</script>
<style is:global>
.landing *{box-sizing:border-box}
.landing{--mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,monospace}
.landing .mono{font-family:var(--mono);font-variant-numeric:tabular-nums}
.landing .kicker{font-size:11px;line-height:1;letter-spacing:.02em;color:var(--ink-faint);margin:0 0 16px}

.landing .hero{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.9fr);gap:48px;align-items:start;max-width:none;margin:0 0 44px;padding:0;border:0}
.landing .hero-copy{max-width:62ch}
.landing .hero h1{margin:0 0 16px}
.landing .lede{color:var(--ink-muted);font-size:17px;line-height:1.65;max-width:58ch;margin:0}

.landing .readout{background:var(--surface)!important;border:1px solid var(--edge)!important;border-radius:14px!important;padding:22px 24px;box-shadow:none!important;align-self:start}
.landing .readout .kicker{margin-bottom:12px}
.landing .readout-place{font-size:24px;font-weight:500;letter-spacing:-.01em;margin:0 0 4px;color:var(--ink)}
.landing .readout-coords{font-size:12px;color:var(--ink-faint);margin:0 0 18px}
.landing .readout-list{display:grid;gap:10px;margin:0;padding-top:16px;border-top:1px solid var(--edge-soft)}
.landing .readout-list>div{display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:baseline}
.landing .readout-list dt{font-size:12px;color:var(--ink-faint)}
.landing .readout-list dd{margin:0;font-family:var(--mono);font-size:12px;color:var(--ink-muted);text-align:right;overflow-wrap:anywhere}

.landing .investigation{margin:0}
.landing .toolbar{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap;margin:0 0 16px}
.landing .field{display:flex;flex-direction:column;gap:8px;font-size:12px;color:var(--ink-faint);margin:0}
.landing .field select{min-width:260px;height:42px;padding:0 12px!important;font-size:14px;color:var(--ink)!important;background:var(--surface)!important;border-color:var(--edge)!important}
.landing .btn-secondary{margin-left:auto;height:42px;padding:0 18px!important;background:var(--surface)!important;color:var(--ink)!important;border:1px solid var(--edge)!important;font-weight:500!important;transition:background-color .16s cubic-bezier(.22,1,.36,1),border-color .16s cubic-bezier(.22,1,.36,1)}
.landing .btn-secondary:hover{background:#182436!important;border-color:#31425c!important;color:var(--ink)!important}

.landing .chart-panel{margin:0 0 28px;border:1px solid var(--edge);border-radius:14px;background:var(--surface);overflow:hidden}
.landing .panel-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:16px 20px;border-bottom:1px solid var(--edge-soft);margin:0}
.landing .panel-head h2{font-size:17px!important;font-weight:500!important;letter-spacing:0;margin:0;color:var(--ink)!important}
.landing .panel-meta{font-size:11px;color:var(--ink-faint);margin:0;text-align:right}
.landing #chart{height:360px;width:100%;border:0!important;background:transparent!important;padding:12px 8px 4px!important;margin:0!important;border-radius:0!important}

.landing .evidence{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.4fr);background:var(--surface);border:1px solid var(--edge);border-radius:12px;overflow:hidden;margin:0 0 28px}
.landing .evidence-lead{padding:22px 24px;border-right:1px solid var(--edge-soft)}
.landing .evidence-figure{font-size:38px;line-height:1;font-weight:500;letter-spacing:-.02em;font-variant-numeric:tabular-nums;margin:10px 0 8px;color:var(--ink)}
.landing .evidence-figure span{font-size:15px;font-weight:400;color:var(--ink-muted);margin-left:6px;letter-spacing:0}
.landing .evidence-sub{font-size:13px;line-height:1.5;color:var(--ink-muted);margin:0}
.landing .evidence-stats{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--edge-soft);margin:0}
.landing .evidence-stats>div{background:var(--surface);padding:16px 20px;min-width:0}
.landing .evidence-stats dt{font-size:11px;color:var(--ink-faint);margin:0 0 6px}
.landing .evidence-stats dd{margin:0;font-family:var(--mono);font-size:16px;color:var(--ink);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}

.landing .interpretation{max-width:72ch}
.landing .interpretation h2{margin:0 0 10px}
.landing .interpretation p{color:var(--ink-muted);font-size:15px;line-height:1.7;margin:0 0 12px}
.landing .interpretation .quality{color:var(--ink-faint);font-size:13px;border-top:1px solid var(--edge-soft);padding-top:12px;margin-top:16px}
.landing .next-step{margin:28px 0 48px;padding:18px 20px;border-color:var(--edge)!important;border-radius:12px!important;background:var(--surface-sunken)!important;box-shadow:none!important}
.landing .next-step .kicker{margin-bottom:8px}
.landing .next-step p:last-child{margin:0;color:var(--ink-muted);font-size:14px;line-height:1.65;max-width:72ch}

.landing .satellite{padding-top:40px;border-top:1px solid var(--edge-soft)}
.landing .section-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:10px}
.landing .section-head h2{margin:0}
.landing .section-head .mono{font-size:11px;color:var(--ink-faint);margin:0}
.landing .satellite .lede{max-width:72ch;margin:0 0 20px}
.landing .frames{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:0 0 12px}
.landing .frame{margin:0;border:1px solid var(--edge);border-radius:12px;overflow:hidden;background:var(--surface)}
.landing .frame img{display:block;width:100%;aspect-ratio:1;object-fit:cover;background:#0a1320;border-radius:0}
.landing .frame figcaption{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;border-top:1px solid var(--edge-soft)}
.landing .frame figcaption .mono{font-size:11px;color:var(--ink-faint)}
.landing .frame input{width:auto;height:34px;padding:0 10px!important;font-family:var(--mono)!important;font-size:12px!important;background:var(--surface-sunken)!important;border-color:var(--edge)!important;color:var(--ink)!important}
.landing .note{font-size:12px;line-height:1.6;color:var(--ink-faint);margin:0 0 8px}

.landing .methods{margin-top:48px;padding-top:40px;border-top:1px solid var(--edge-soft)}
.landing .method-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin:0 0 24px}
.landing .method-grid h3{font-size:13px;font-weight:500;margin:0 0 8px;color:var(--ink)}
.landing .method-grid p{font-size:14px;line-height:1.65;color:var(--ink-muted);margin:0;max-width:36ch}
.landing .source-links{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:14px;margin:0}
.landing .source-links .mono{color:var(--ink-faint);font-size:11px}
.landing details{margin-top:24px}

@media(max-width:960px){
.landing .hero{grid-template-columns:1fr;gap:24px}
.landing .readout{max-width:none}
.landing .evidence{grid-template-columns:1fr}
.landing .evidence-lead{border-right:0;border-bottom:1px solid var(--edge-soft)}
.landing .method-grid{grid-template-columns:1fr;gap:20px}
}
@media(max-width:700px){
.landing .toolbar{gap:12px}
.landing .field{width:100%}
.landing .field select{width:100%;min-width:0}
.landing .btn-secondary{margin-left:0;width:100%}
.landing .frames{grid-template-columns:1fr}
.landing #chart{height:300px}
.landing .panel-head{flex-direction:column;align-items:flex-start;gap:4px}
.landing .panel-meta{text-align:left}
.landing .evidence-figure{font-size:32px}
}
@media(prefers-reduced-motion:reduce){
.landing *{transition:none!important}
}
</style>
</body></html>
