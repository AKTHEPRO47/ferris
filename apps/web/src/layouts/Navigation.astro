---
import '../styles/theme.css';
import OrbitalBackground from './OrbitalBackground.astro';
const { title } = Astro.props;
const links = [['/ml','ML Lab'],['/earth','3D Earth'],['/mirage','Green Mirage'],['/atlas','Contradiction Atlas'],['/twin','Digital Twin'],['/discover','Guided discovery'],['/','Mission control'],['/compare','Compare regions'],['/satellite','Satellite explorer'],['/catalog','Data catalog'],['/methods','Science guide'],['/reports','Research reports'],['/faq','FAQ'],['/example','Learning lab']];
---
<OrbitalBackground/>
<nav aria-label="Main navigation"><a class="brand" href="/">ferris<span class="brand-caption">EARTH INTELLIGENCE</span></a><div>{links.map(([href,label])=><a href={href} aria-current={Astro.url.pathname.replace(/\/$/,'')===href.replace(/\/$/,'')?'page':undefined}>{label}</a>)}</div></nav>
<style is:global>
nav{padding:16px 4%;display:flex;gap:24px;align-items:center;flex-wrap:wrap;background:#0a1220;border-bottom:1px solid #1c2738}nav .brand{font-size:29px;font-weight:600;letter-spacing:-1px;color:#e7eef5;text-decoration:none}nav>div{display:flex;gap:4px;flex-wrap:wrap}nav>div>a{padding:8px 10px;border-radius:7px;text-decoration:none;font-size:12px;color:#a9bacd}nav a[aria-current=page]{background:#15243a;color:#d6e9ef}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid #9ed0da;outline-offset:3px}
</style>
